APP_ENV=local
NGINX_PORT=8080
ADMINER_PORT=8081
MYSQL_PORT=3306
MYSQL_DATABASE=elections
MYSQL_USER=elections
MYSQL_PASSWORD=elections_dev_only
MYSQL_ROOT_PASSWORD=root_dev_only
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_STEPS=5
OPENROUTER_HISTORY_MESSAGES=6
OPENROUTER_INPUT_COST_PER_MILLION=0
OPENROUTER_OUTPUT_COST_PER_MILLION=0
CACHE_TTL_SECONDS=3600
CACHE_PAST_ELECTION_TTL_SECONDS=31536000
CACHE_ACTIVE_ELECTION_TTL_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60